library(tidyverse)
library(patchwork)
df <- read.csv('results/results_2025-08-15_18-03-56.csv')
summary_df <- df %>% group_by(coherence, threshold, subID) %>%
summarise(rawChoice_accuracy = mean(rawChoiceAccuracy, na.rm=T),
forcedChoice_accuracy = mean(forcedChoiceAccuracy),
rawChoice_rt = mean(rawChoiceRT, na.rm=T))
write.csv(summary_df, 'results/results_2025-08-15_summary.csv', row.names = F)
## plot accuracy
summary_df %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold)) +
theme_bw() + geom_hline(yintercept = 0, color='gray30')
## plot accuracy
summary_df %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold)) +
theme_bw() + geom_hline(yintercept = 0, color='gray30') +
geom_point()
## plot accuracy
summary_df %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0, color='gray30') +
geom_point()
## plot accuracy
summary_df %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
geom_point()
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
geom_point()
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
stat_summary(fun.data = 'mean_se', geom='pointrange')
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
stat_summary(fun = 'mean', geom='line') +
stat_summary(fun.data = 'mean_se', geom='pointrange')
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
stat_summary(fun = 'mean', geom='line') +
stat_summary(fun.data = 'mean_se', geom='pointrange') +
geom_hline(yintercept = 0.7, linetype = 'dashed')
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
stat_summary(fun = 'mean', geom='line') +
stat_summary(fun.data = 'mean_se', geom='pointrange') +
geom_hline(yintercept = 0.7, linetype = 'dashed') +
facet_wrap(~ threshold)
## plot accuracy
summary_df %>%
mutate(threshold = factor(threshold)) %>%
ggplot(aes(x=coherence, y=rawChoice_accuracy, color=threshold, group=threshold)) +
theme_bw() + geom_hline(yintercept = 0.5, color='gray30') +
stat_summary(fun = 'mean', geom='line') +
stat_summary(fun.data = 'mean_se', geom='pointrange') +
geom_hline(yintercept = 0.7, linetype = 'dashed') +
facet_wrap(~ threshold) +
labs(title = 'raw choice accuracy')
